# Copy this file to .env.local and fill in local development values.
# ORTHANC_API_TOKEN is server-side development configuration. Never rename it
# to VITE_ORTHANC_API_TOKEN or otherwise expose it to browser code.
ORTHANC_BASE_URL=
ORTHANC_API_TOKEN=

# Optional smoke-test settings. These defaults are used when omitted.
ORTHANC_FIGURANT_GROUP_NAME=monsterland
ORTHANC_SMOKE_TIMEOUT_MS=10000
