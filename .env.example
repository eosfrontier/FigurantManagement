# Copy this file to .env.local and fill in local development values.
# ORTHANC_API_TOKEN is server-side development configuration. Never rename it
# to VITE_ORTHANC_API_TOKEN or otherwise expose it to browser code.
ORTHANC_BASE_URL=
ORTHANC_API_TOKEN=

# Optional smoke-test settings. These defaults are used when omitted.
ORTHANC_FIGURANT_GROUP_NAME=monsterland
ORTHANC_SMOKE_TIMEOUT_MS=10000

# Browser-safe frontend configuration. Mock mode is the default.
VITE_DATA_SOURCE=mock
VITE_MOCK_DELAY_MS=150
VITE_ORTHANC_FIGURANT_GROUP_NAME=monsterland
# Public character-generator base that serves /img/passphoto/npc/{user-id}.jpg.
# Leave empty when that service is unavailable; the roster will show placeholders.
VITE_NPC_PHOTO_BASE_URL=https://www.eosfrontier.space/eoschargen
# Optional; defaults to the deployed public read-only Watchtower route.
VITE_WATCHTOWER_BASE_URL=https://api.eosfrontier.space/watchtower/
# Mock mutations are enabled by default. Live mode defaults to false and should
# be enabled only for a controlled test or behind an authorized deployed proxy.
# VITE_ENABLE_MUTATIONS=false

# Joomla session visibility. Vite cannot execute the PHP helper, so local
# development uses a fictional manager session. Hosted Joomla deployments should
# set VITE_AUTH_MODE=joomla and serve /assets/idandgroups.php from the same origin.
VITE_AUTH_MODE=mock
VITE_JOOMLA_MANAGER_GROUPS=30,36,8,31
VITE_JOOMLA_MOCK_USER={"id":"local-manager","groups":["30"]}
VITE_JOOMLA_LOGIN_URL=https://www.eosfrontier.space/return-to-persona
